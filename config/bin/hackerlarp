    ui.line()


def module_firewall(ui: UI, rng: random.Random):
    target = rng.choice(ui.cfg.get("targets", DEFAULT_CONFIG["targets"]))
    ui.type_line(ui.prompt(), f"fw-bypass --target {target} --technique fragmentation")
    rules = ["DROP 22/tcp", "ALLOW 443/tcp", "DROP ICMP", "ALLOW 8080/tcp", "DROP *"]
    for r in rules:
        if STOP: return
        ui.line(f"[RULE] {r:<16} -> probing...", "dim")
        ui.sleep(0.07)
        ui.line(f"       {'bypassed' if rng.random()>0.4 else 'blocked'} via segment {rand_hex(4)}", "main")
    ui.line("[+] Firewall mapped. Found dramatic gap in rule #3.", "bright")
    ui.line()


def module_ssh_tunnel(ui: UI, rng: random.Random):
    hop1 = rand_ip(rng)
    hop2 = rand_ip(rng)
    target = rng.choice(ui.cfg.get("targets", DEFAULT_CONFIG["targets"]))
    ui.type_line(ui.prompt(), f"ssh -J {hop1},{hop2} root@{target}")
    ui.line(f"[*] establishing hop 1: {hop1}", "dim"); ui.sleep(0.1)
    ui.line(f"[*] establishing hop 2: {hop2}", "dim"); ui.sleep(0.1)
    ui.line(f"[*] connecting to {target}", "dim"); ui.sleep(0.1)
    ui.progress("negotiating encrypted tunnel", total=18, delay=0.04)
    ui.line(f"[+] Tunnel up: localhost:1337 -> {hop1} -> {hop2} -> {target}:22", "bright")
    ui.line()

