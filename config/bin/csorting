#!/usr/bin/env python3
"""csorting - ambient sorting visualizer: dots in a circle or bars in a line.

Real in-place sorting algorithms, rendered at a low fixed frame rate. In circle
mode dots start scattered and gather into a filled gradient disk as the sort
advances. A fully sorted run is held for three seconds, then reshuffled.
Colors come from matugen when available, or from --color. Ctrl+C, Ctrl+D or q exits.
No dependencies beyond the Python standard library.
"""
import argparse
import json
import math
import os
import random
import select
import shutil
import sys
import termios
import time
import tty


def bubble(a):
    n = len(a)
    for end in range(n - 1, 0, -1):
        swapped = False
        for i in range(end):
            if a[i] > a[i + 1]:
                a[i], a[i + 1] = a[i + 1], a[i]
                swapped = True
                yield i, i + 1
        if not swapped:
            break


def cocktail(a):
    lo, hi = 0, len(a) - 1
    while lo < hi:
        swapped = False
        for i in range(lo, hi):
            if a[i] > a[i + 1]:
                a[i], a[i + 1] = a[i + 1], a[i]
                swapped = True
                yield i, i + 1
        hi -= 1
        for i in range(hi, lo, -1):
            if a[i - 1] > a[i]:
                a[i - 1], a[i] = a[i], a[i - 1]
                swapped = True
                yield i - 1, i
        lo += 1
        if not swapped:
            break


def gnome(a):
    i = 1
    while i < len(a):
        if i == 0 or a[i - 1] <= a[i]:
            i += 1
        else:
            a[i - 1], a[i] = a[i], a[i - 1]
            yield i - 1, i
            i -= 1


def insertion(a):
    for i in range(1, len(a)):
        j = i
        while j > 0 and a[j - 1] > a[j]:
            a[j], a[j - 1] = a[j - 1], a[j]
            yield j, j - 1
            j -= 1


def selection(a):
    n = len(a)
    for i in range(n):
        m = i
        for j in range(i + 1, n):
            if a[j] < a[m]:
                m = j
                yield j, m
        if m != i:
            a[i], a[m] = a[m], a[i]
            yield i, m


def shell(a):
    n = len(a)
    gap = n // 2
    while gap:
        for i in range(gap, n):
            j = i
            while j >= gap and a[j - gap] > a[j]:
                a[j], a[j - gap] = a[j - gap], a[j]
                yield j, j - gap
                j -= gap
        gap //= 2


def comb(a):
    n = len(a)
    gap = n
    swapped = True
    while gap > 1 or swapped:
        gap = max(1, int(gap / 1.3))
        swapped = False
        for i in range(n - gap):
            if a[i] > a[i + gap]:
                a[i], a[i + gap] = a[i + gap], a[i]
                swapped = True
                yield i, i + gap


def oddeven(a):
    n = len(a)
    ordered = False
    while not ordered:
        ordered = True
        for start in (0, 1):
            for i in range(start, n - 1, 2):
                if a[i] > a[i + 1]:
                    a[i], a[i + 1] = a[i + 1], a[i]
                    ordered = False
                    yield i, i + 1


def quick(a):
    stack = [(0, len(a) - 1)]
    while stack:
        lo, hi = stack.pop()
        if lo >= hi:
            continue
        pivot = a[hi]
        i = lo
        for j in range(lo, hi):
            if a[j] < pivot:
                a[i], a[j] = a[j], a[i]
                yield i, j
                i += 1
        a[i], a[hi] = a[hi], a[i]
        yield i, hi
        stack.append((lo, i - 1))
        stack.append((i + 1, hi))


def heap(a):
    n = len(a)

    def sift(root, end):
        while True:
            child = 2 * root + 1
            if child > end:
                return
            if child + 1 <= end and a[child] < a[child + 1]:
                child += 1
            if a[root] >= a[child]:
                return
            a[root], a[child] = a[child], a[root]
            yield root, child
            root = child

    for root in range(n // 2 - 1, -1, -1):
        yield from sift(root, n - 1)
    for end in range(n - 1, 0, -1):
        a[0], a[end] = a[end], a[0]
        yield 0, end
        yield from sift(0, end - 1)


def merge(a):
    n = len(a)
    width = 1
    while width < n:
        for left in range(0, n, 2 * width):
            mid, right = min(left + width, n), min(left + 2 * width, n)
            if mid >= right:
                continue
            i, j = left, mid
            out = []
            while i < mid and j < right:
                src = i if a[i] <= a[j] else j
                out.append(a[src])
                yield src, left + len(out) - 1
                i += src == i
                j += src == j
            while i < mid:
                out.append(a[i])
                yield i, left + len(out) - 1
                i += 1
            while j < right:
                out.append(a[j])
                yield j, left + len(out) - 1
                j += 1
            a[left:right] = out
        width *= 2


ALGORITHMS = {
    "bubble": bubble,
    "cocktail": cocktail,
    "gnome": gnome,
    "insertion": insertion,
    "selection": selection,
    "shell": shell,
    "comb": comb,
    "oddeven": oddeven,
    "quick": quick,
    "heap": heap,
    "merge": merge,
}


PALETTES = {
    "rainbow": ("#3b1e6e", "#2f6bff", "#00d9ff", "#4dff9f", "#ffd166", "#ff4d6d"),
    "ocean": ("#040f2e", "#0b3d91", "#0077b6", "#00b4d8", "#90e0ef"),
    "fire": ("#1a0500", "#7f1d1d", "#ea580c", "#facc15", "#fff7ed"),
    "ice": ("#0b132b", "#1c3d5a", "#4d908e", "#a8dadc", "#f1faee"),
    "mono": ("#181818", "#6e6e6e", "#dcdcdc", "#ffffff"),
    "matugen": (),  # filled from the generated palette at runtime
}


def parse_hex(value):
    text = str(value).strip().lstrip("#")
    if len(text) == 3:
        text = "".join(ch * 2 for ch in text)
    if len(text) != 6 or any(ch not in "0123456789abcdefABCDEF" for ch in text):
        raise ValueError(f"invalid color {value!r}; use #rgb or #rrggbb")
    return tuple(int(text[i:i + 2], 16) for i in (0, 2, 4))


def matugen_colors():
    home = os.path.expanduser("~")
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(home, ".local", "state")
    paths = (
        os.environ.get("MATUGEN_COLORS_FILE", ""),
        os.path.join(state, "quickshell", "user", "generated", "colors.json"),
        os.path.join(home, ".config", "matugen", "colors.json"),
        os.path.join(home, ".cache", "matugen", "colors.json"),
    )
    for raw in paths:
        if not raw:
            continue
        path = os.path.expandvars(os.path.expanduser(raw))
        try:
            with open(path, encoding="utf-8") as handle:
                data = json.load(handle)
        except (OSError, ValueError, TypeError):
            continue
        stops = []
        for key in ("background", "primary", "tertiary", "secondary", "on_background"):
            if key in data:
                try:
                    stops.append(parse_hex(data[key]))
                except ValueError:
                    pass
        if len(stops) >= 2:
            return stops
    return None


def resolve_palette(spec):
    """Return (RGB stops, label). No spec means matugen, then rainbow."""
    if spec is None:
        stops = matugen_colors()
        if stops:
            return stops, "matugen"
        return [parse_hex(c) for c in PALETTES["rainbow"]], "rainbow"
    if spec in PALETTES:
        if spec != "matugen":
            return [parse_hex(c) for c in PALETTES[spec]], spec
        stops = matugen_colors()
        if stops:
            return stops, "matugen"
        return [parse_hex(c) for c in PALETTES["rainbow"]], "rainbow (no matugen)"
    parts = [part for part in spec.split(",") if part.strip()]
    if len(parts) < 2:
        raise ValueError("--color needs a palette name or 2+ hex colors")
    return [parse_hex(part) for part in parts], "custom"


def gradient_color(position, stops):
    t = min(1.0, max(0.0, position))
    scaled = t * (len(stops) - 1)
    index = min(int(scaled), len(stops) - 2)
    mix = scaled - index
    return tuple(round(stops[index][c] * (1 - mix) + stops[index + 1][c] * mix)
                 for c in range(3))


def paint(value, n, stops, active=False):
    r, g, b = gradient_color(value / max(1, n - 1), stops)
    return f"\x1b[38;2;{r};{g};{b}m" + ("\x1b[7m" if active else "")


FILL_CAP = 1200


def circle_geometry(cols, rows):
    """Grid cells of a filled disk, ordered radially for a smooth gradient."""
    height = max(7, rows - 1)
    cx, cy = cols // 2, height // 2
    ry = max(2, min((rows - 2) // 2, (cols - 3) // 4))
    rx = ry * 2  # terminal cells are about twice as tall as wide
    candidates = []
    for y in range(height):
        for x in range(cols):
            dx, dy = x - cx, (y - cy) * 2
            distance = math.hypot(dx, dy)
            if distance <= rx:
                candidates.append((distance, math.atan2(dy, dx), x, y))
    step = max(1, math.ceil(len(candidates) / FILL_CAP))
    candidates = candidates[::step][:FILL_CAP]
    candidates.sort()
    return height, [(x, y) for _, _, x, y in candidates]


def sample_cells(cells, cap=FILL_CAP):
    """Keep the radial order but thin out very large terminals."""
    if len(cells) <= cap:
        return list(cells)
    step = math.ceil(len(cells) / cap)
    return cells[::step][:cap]


def gather_progress(values):
    """Fraction of elements already in their final slot, normalized."""
    n = len(values)
    if n < 2:
        return 1.0
    correct = sum(1 for i, value in enumerate(values) if i == value)
    baseline = 1.0 / n
    return min(1.0, max(0.0, (correct / n - baseline) / (1 - baseline)))


def frame(values, mode, active, algorithm, steps, rate, cols, rows, stops, palette,
          ring=None, progress=1.0, scatter=None, sorted_=False):
    active = set(active or ())
    n = len(values)
    title = f" csorting | {mode} | {algorithm} | {palette} | ops {rate}/s"
    if mode == "circle" and not sorted_:
        title += f" | gather {int(min(1.0, max(0.0, progress)) * 100)}%"
    if sorted_:
        title += " | SORTED - reshuffling"
    title += " | ctrl+c/ctrl+d/q"

    if mode == "line":
        height = max(5, rows - 1)
        grid = [[" "] * n for _ in range(height)]
        for i, value in enumerate(values):
            bar = max(1, round(value / max(1, n - 1) * height))
            for y in range(height - bar, height):
                grid[y][i] = paint(value, n, stops, i in active) + "█" + "\x1b[0m"
        lines = ["".join(row) for row in grid]
    else:
        height, ring = circle_geometry(cols, rows) if ring is None else (max(7, rows - 1), ring)
        grid = [[" "] * cols for _ in range(height)]
        p = min(1.0, max(0.0, progress))
        eased = p * p * (3 - 2 * p)
        for i, value in enumerate(values):
            target_x, target_y = ring[i % len(ring)]
            if scatter:
                sx, sy = scatter[value % len(scatter)]
                x = round(sx + (target_x - sx) * eased)
                y = round(sy + (target_y - sy) * eased)
                x = min(cols - 1, max(0, x))
                y = min(height - 1, max(0, y))
            else:
                x, y = target_x, target_y
            cell = "●" if i in active else "•"
            grid[y][x] = paint(value, n, stops, i in active) + cell + "\x1b[0m"
        lines = ["".join(row).rstrip() for row in grid]

    body = [title] + lines
    sys.stdout.write("\x1b[H" + "\r\n".join(line + "\x1b[K" for line in body))
    sys.stdout.flush()


def quit_requested():
    if not select.select([sys.stdin], [], [], 0)[0]:
        return False
    return sys.stdin.read(1) in ("\x03", "\x04", "q", "Q", "\x1b")


def hold(seconds):
    """Pause on the sorted frame while still reacting to exit keys."""
    end = time.monotonic() + seconds
    while True:
        if quit_requested():
            return False
        remaining = end - time.monotonic()
        if remaining <= 0:
            return True
        time.sleep(min(0.05, remaining))


def self_test():
    rng = random.Random(20261124)
    for name, algorithm in ALGORITHMS.items():
        for size in (0, 1, 2, 7, 31, 64):
            source = [rng.randrange(1000) for _ in range(size)]
            values = list(source)
            for _ in algorithm(values):
                pass
            assert values == sorted(source), f"{name} failed for size {size}"
    rainbow = [parse_hex(c) for c in PALETTES["rainbow"]]
    assert gradient_color(0, rainbow) == rainbow[0]
    assert gradient_color(1, rainbow) == rainbow[-1]
    assert gradient_color(0.5, rainbow) != rainbow[0]
    assert parse_hex("#abc") == (170, 187, 204)
    cells = circle_geometry(100, 30)[1]
    assert 500 < len(cells) <= FILL_CAP
    assert gather_progress(list(range(8))) == 1.0
    assert gather_progress([3, 1, 0, 2]) == 0.0
    print(f"OK: {len(ALGORITHMS)} sorting algorithms, gradients and circle fill pass self-test")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    view = parser.add_mutually_exclusive_group()
    view.add_argument("--circle", action="store_true", help="filled gradient disk (default: line)")
    view.add_argument("--line", action="store_true", help="long vertical bars (default)")
    parser.add_argument("algorithm_pos", nargs="?", help="algorithm name (same as -a)")
    parser.add_argument("-a", "--algorithm", help="algorithm name or 'all' to cycle through them")
    parser.add_argument("-C", "--color", help="palette name or 2+ hex stops (default: matugen, then rainbow)")
    parser.add_argument("-n", "--items", type=int, default=0, help="number of elements")
    parser.add_argument("--delay", type=float, default=0.05, help="minimum seconds per rendered frame")
    parser.add_argument("--list", action="store_true", help="list algorithms and exit")
    parser.add_argument("--palettes", action="store_true", help="list color palettes and exit")
    parser.add_argument("--self-test", action="store_true", help="verify every algorithm and exit")
    args = parser.parse_args()
    algorithm = args.algorithm or args.algorithm_pos or "all"
    if args.items < 0:
        parser.error("--items must not be negative")

    if args.self_test:
        self_test()
        return 0
    if args.list:
        print(" ".join(ALGORITHMS))
        return 0
    if args.palettes:
        print(" ".join(name for name in PALETTES if name != "matugen"))
        return 0
    try:
        stops, palette = resolve_palette(args.color)
    except ValueError as exc:
        parser.error(str(exc))
    if algorithm != "all" and algorithm not in ALGORITHMS:
        parser.error(f"unknown algorithm {algorithm!r}; choose from: {' '.join(ALGORITHMS)}")
    if not sys.stdout.isatty():
        parser.error("csorting needs a terminal")

    mode = "circle" if args.circle else "line"
    size = shutil.get_terminal_size((80, 24))
    cols, rows = size.columns, size.lines
    cells = sample_cells(circle_geometry(cols, rows)[1]) if mode == "circle" else None
    default_n = len(cells) if mode == "circle" else min(cols - 2, 240)
    n = args.items or default_n
    n = min(n, len(cells) if mode == "circle" else max(1, cols - 2))
    names = list(ALGORITHMS) if algorithm == "all" else [algorithm]
    scatter = ([(random.uniform(1, cols - 2), random.uniform(1, rows - 2)) for _ in range(n)]
               if mode == "circle" else None)
    frame_interval = max(0.016, args.delay)
    batch = max(1, n // 3)
    current = 0

    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    settings = termios.tcgetattr(sys.stdin)
    try:
        tty.setcbreak(sys.stdin.fileno())
        while True:
            values = list(range(n))
            random.shuffle(values)
            name = names[current]
            current = (current + 1) % len(names)
            steps = 0
            run_start = time.monotonic()
            last_render = run_start

            def draw(active, progress=1.0, sorted_=False):
                nonlocal last_render
                elapsed = max(0.001, time.monotonic() - run_start)
                rate = int(steps / elapsed)
                started = time.monotonic()
                frame(values, mode, active, name, steps, rate, cols, rows, stops, palette,
                      cells, progress, scatter, sorted_=sorted_)
                last_render = time.monotonic()
                time.sleep(max(0.0, frame_interval - (last_render - started)))

            if mode == "circle":
                draw((), progress=0.0)
            for active in ALGORITHMS[name](values):
                if quit_requested():
                    return 0
                steps += 1
                now = time.monotonic()
                if steps % batch == 0 or now - last_render >= frame_interval:
                    progress = gather_progress(values) if mode == "circle" else 1.0
                    draw(active, progress)
            draw((), progress=1.0, sorted_=True)
            if not hold(3.0):
                return 0
    except KeyboardInterrupt:
        return 0
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, settings)
        sys.stdout.write("\x1b[?25h\x1b[?1049l\x1b[0m")
        sys.stdout.flush()


if __name__ == "__main__":
    sys.exit(main())
