#!/usr/bin/env python3
"""fakefetch - fake fastfetch/neofetch output for any distro/logo."""
from __future__ import annotations
import argparse, os, random, shutil, sys, subprocess

# Small simple logos by key
LOGOS = {
"arch": [r"      /\      ",r"     /  \     ",r"    /\   \    ",r"   /      \   ",r"  /   ,,   \  ",r" /   |  |  -\ ",r"/_-''    ''-_\\"],
