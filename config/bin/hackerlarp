    ui.progress(f"cloning {repo}", total=26, delay=0.03)
    files = ["README.md", ".env", "deploy.yml", "id_rsa.bak", "secrets.json", "todo.txt"]
    for f in rng.sample(files, k=rng.randint(3, 5)):
        if STOP: return
        ui.line(f"[LEAK] found interesting file: {f}", "main")
        ui.sleep(0.07)
    ui.line(f"[+] Repository cloned. {rng.randint(1,99)} commits, {rng.randint(1,20)} contributors, 1 bad decision.", "bright")
    ui.line()


def module_docker(ui: UI, rng: random.Random):
    target = rng.choice(ui.cfg.get("targets", DEFAULT_CONFIG["targets"]))
    ui.type_line(ui.prompt(), f"docker --host tcp://{target}:2375 ps -a")
    containers = ["redis", "postgres", "nginx", "totally-legit-miner", "backend", "secrets-vault"]
    for c in rng.sample(containers, k=rng.randint(3, 5)):
        if STOP: return
        status = rng.choice(["Up 3 days", "Exited (1)", "Up 42 hours"])
        ui.line(f"{rand_hex(12)}  {c:<22}  {status:<12}  0.0.0.0:{rng.randint(1024,9999)}->80/tcp", "main")
        ui.sleep(0.08)
    ui.type_line(ui.prompt(), "docker exec -it totally-legit-miner /bin/sh")
    ui.line("[+] Shell attached" + (" (cinematic)." if ui.show_disclaimer else "."), "bright")
    ui.line()


