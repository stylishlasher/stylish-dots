"mint": [r" ___________ ",r"|_          \\",r"  | | _____ |",r"  | | | | | |",r"  | | |_| | |",r"  | \_____/ |",r"  \_________/"],
"alpine": [r"    /\    ",r"   /  \   ",r"  / /\ \  ",r" / /  \ \ ",r"/_/    \_\\"],
"kali": [r"      ..   ",r"     .:.   ",r"    .:::.  ",r"   .:::::. ",r"  .::::::. ",r" .::::::::."],
}

ALIAS = {
"archlinux":"arch","arch linux":"arch","endeavour":"endeavouros","endeavouros":"endeavouros","debian":"debian",
"ubuntu":"ubuntu","fedora":"fedora","manjaro":"manjaro","nixos":"nixos","gentoo":"gentoo","windows":"windows",
"win11":"windows","windows11":"windows","mac":"macos","macos":"macos","osx":"macos","linux":"linux",
"void":"void","mint":"mint","linuxmint":"mint","alpine":"alpine","kali":"kali","kalilinux":"kali"
}

DISTRO_INFO = {
"arch": ("Arch Linux","6.9.7-arch1-1","pacman","Hyprland","fish","kitty","AMD Ryzen 7","NVIDIA RTX 4070"),
"endeavouros": ("EndeavourOS","6.9.7-arch1-1","pacman","Hyprland","fish","foot","AMD Ryzen 5","Radeon RX 6800"),
"ubuntu": ("Ubuntu 24.04 LTS","6.8.0-35-generic","apt","GNOME","bash","gnome-terminal","Intel i7","Intel Iris Xe"),
"debian": ("Debian GNU/Linux 12","6.1.0-21-amd64","apt","GNOME","bash","xterm","Intel i5","Intel UHD"),
