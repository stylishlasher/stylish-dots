#!/usr/bin/env python3
"""quicknote - append/search quick notes in ~/Notes/quicknotes.md"""
from __future__ import annotations
import argparse, datetime, os, subprocess
from pathlib import Path

NOTES = Path(os.environ.get("QUICKNOTE_FILE", Path.home()/"Notes/quicknotes.md"))

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("text", nargs="*", help="Note text; if empty opens $EDITOR")
    ap.add_argument("-l","--list", action="store_true")
    ap.add_argument("-s","--search", default=None)
    args=ap.parse_args()
    NOTES.parent.mkdir(parents=True, exist_ok=True)
    if args.list or args.search:
        if not NOTES.exists(): return
        for line in NOTES.read_text(encoding="utf-8", errors="ignore").splitlines():
            if args.search and args.search.lower() not in line.lower(): continue
            print(line)
        return
    text=" ".join(args.text).strip()
    if not text:
        ed=os.environ.get("EDITOR","nvim")
        subprocess.call([ed,str(NOTES)])
        return
    ts=datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    with NOTES.open("a",encoding="utf-8") as f:
        f.write(f"- [{ts}] {text}\n")
    print(NOTES)

if __name__=="__main__":
    main()
