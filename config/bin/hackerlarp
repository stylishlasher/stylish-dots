#!/usr/bin/env python3
"""hackerlarp - configurable rofl/larp Hollywood-style terminal toy.

No real hacking. Everything is fake/simulated for fun.
"""
from __future__ import annotations

import argparse
import json
import os
import random
import shutil
import signal
import string
import sys
import time
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hackerlarp"
CONFIG_FILE = CONFIG_DIR / "config.json"

DEFAULT_CONFIG = {
    "speed": 1.0,               # global speed multiplier; >1 faster, <1 slower
    "duration": 0,              # 0 = infinite until Ctrl+C
    "seed": None,               # int or null for random
    "color": True,
    "theme": "green",           # green, amber, cyan, red, purple, rainbow
    "username": os.environ.get("USER", "operator"),
    "hostname": os.uname().nodename if hasattr(os, "uname") else "localhost",
    "modules": [
        "banner", "scan", "bruteforce", "decrypt", "download", "exploit", "exfil", "matrix",
        "wifi", "trace", "sqlinject", "ddos", "bitcoin", "camera", "git", "docker",
        "phishing", "wipe", "compile", "satellite", "firewall", "ssh_tunnel"
    ],
    "loop": True,
    "safe_mode": True,          # always true; cosmetic flag in UI only
    "show_disclaimer": True,    # show fake/simulation notices
    "matrix_lines": 18,
    "download_files": [
        "mainframe_dump.db", "secrets.zip", "blackmail.txt", "definitely_not_a_virus.bin",
        "kernel_soul.tar.gz", "passwords_final_FINAL_v2.csv"
    ],
    "targets": [
        "10.13.37.42", "192.168.1.1", "mainframe.local", "vault.corp.internal",
        "satellite-7.orbit", "toaster.iot.home"
    ],
    "wordlist": [
        "admin", "password", "letmein", "hunter2", "correcthorsebatterystaple",
        "qwerty", "iloveyou", "monkey", "dragon", "ninja", "root", "toor"
    ],
}

THEMES = {
    "green":  ("\033[32m", "\033[92m", "\033[90m"),
    "amber":  ("\033[33m", "\033[93m", "\033[90m"),
    "cyan":   ("\033[36m", "\033[96m", "\033[90m"),
    "red":    ("\033[31m", "\033[91m", "\033[90m"),
    "purple": ("\033[35m", "\033[95m", "\033[90m"),
    "rainbow": None,
}

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"

STOP = False


def handle_sigint(_sig, _frame):
    global STOP
    STOP = True


signal.signal(signal.SIGINT, handle_sigint)


def load_config(path: Path | None = None) -> dict:
    cfg = dict(DEFAULT_CONFIG)
    p = path or CONFIG_FILE
    if p.exists():
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                cfg.update(data)
        except Exception:
            pass
    return cfg


def save_default_config(path: Path = CONFIG_FILE) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    if not path.exists():
        path.write_text(json.dumps(DEFAULT_CONFIG, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return path


class UI:
    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.color = bool(cfg.get("color", True)) and sys.stdout.isatty()
        self.theme = cfg.get("theme", "green")
        self.speed = max(0.05, float(cfg.get("speed", 1.0)))
        self.width = shutil.get_terminal_size((80, 24)).columns
        self.show_disclaimer = bool(cfg.get("show_disclaimer", True))

    def c(self, text: str, kind: str = "main") -> str:
        if not self.color:
            return text
        if self.theme == "rainbow":
            colors = ["\033[31m", "\033[33m", "\033[32m", "\033[36m", "\033[34m", "\033[35m"]
            out = []
            for i, ch in enumerate(text):
                out.append(colors[i % len(colors)] + ch)
            out.append(RESET)
            return "".join(out)
        main, bright, dim = THEMES.get(self.theme, THEMES["green"])
        if kind == "bright":
            return bright + text + RESET
        if kind == "dim":
            return dim + text + RESET
        if kind == "bold":
            return BOLD + main + text + RESET
        return main + text + RESET

    def sleep(self, base: float):
        t = base / self.speed
        end = time.time() + t
        while time.time() < end:
            if STOP:
                return
            time.sleep(min(0.03, max(0, end - time.time())))

    def line(self, text: str = "", kind: str = "main", end: str = "\n"):
        sys.stdout.write(self.c(text, kind) + end)
        sys.stdout.flush()

    def type_line(self, prefix: str, text: str, delay: float = 0.008):
        sys.stdout.write(self.c(prefix, "dim"))
        sys.stdout.flush()
        for ch in text:
            if STOP:
                break
            sys.stdout.write(self.c(ch, "main"))
            sys.stdout.flush()
            self.sleep(delay)
        sys.stdout.write("\n")
        sys.stdout.flush()

    def progress(self, label: str, total: int = 32, delay: float = 0.05):
        for i in range(total + 1):
            if STOP:
                return
            pct = int(i * 100 / total)
            filled = int(i * 24 / total)
            bar = "#" * filled + "-" * (24 - filled)
            sys.stdout.write("\r" + self.c(f"[{bar}] {pct:3d}% {label}", "bright"))
            sys.stdout.flush()
            self.sleep(delay + random.random() * delay)
        sys.stdout.write("\n")
        sys.stdout.flush()

    def prompt(self) -> str:
        u = self.cfg.get("username", "operator")
        h = self.cfg.get("hostname", "localhost")
        return f"{u}@{h}:~$ "


def rand_hex(n: int) -> str:
    return "".join(random.choice("0123456789abcdef") for _ in range(n))


def rand_ip(rng: random.Random) -> str:
    return ".".join(str(rng.randint(1, 254)) for _ in range(4))


def module_banner(ui: UI, rng: random.Random):
    art = [
        " _   _    _    ____ _  _______ ____  _        _    ____  ____  ",
        "| | | |  / \\  / ___| |/ / ____|  _ \\| |      / \\  |  _ \\|  _ \\ ",
        "| |_| | / _ \\| |   | ' /|  _| | |_) | |     / _ \\ | |_) | |_) |",
        "|  _  |/ ___ \\ |___| . \\| |___|  _ <| |___ / ___ \\|  _ <|  __/ ",
        "|_| |_/_/   \\_\\____|_|\\_\\_____|_| \\_\\_____/_/   \\_\\_| \\_\\_|    ",
    ]
    for line in art:
        ui.line(line, "bold")
        ui.sleep(0.03)
    if ui.show_disclaimer:
        ui.line("  [ SIMULATION MODE ]  No real hacking. Just cinematic nonsense.", "dim")
    ui.line(f"  theme={ui.cfg.get('theme')} speed={ui.cfg.get('speed')} modules={len(ui.cfg.get('modules', []))}", "dim")
    ui.line()


def module_scan(ui: UI, rng: random.Random):
    target = rng.choice(ui.cfg.get("targets", DEFAULT_CONFIG["targets"]))
    ui.type_line(ui.prompt(), f"nmap -sV -Pn {target}")
    ports = [22, 53, 80, 443, 8080, 31337, rng.randint(1024, 65535)]
    ui.line(f"Starting fake scan on {target}", "dim")
    for p in sorted(set(ports)):
        if STOP: return
        svc = rng.choice(["ssh", "http", "https", "mystery", "coffee-api", "mainframe", "unknown"])
        state = rng.choice(["open", "open", "filtered"])
        ui.line(f"{p:5d}/tcp  {state:<8}  {svc:<12}  fingerprint={rand_hex(8)}", "main")
        ui.sleep(0.08)
    msg = f"Scan complete: {len(set(ports))} ports checked"
    if ui.show_disclaimer:
        msg += ", 0 laws broken"
    msg += "."
    ui.line(msg, "bright")
    ui.line()


def module_bruteforce(ui: UI, rng: random.Random):
    target = rng.choice(ui.cfg.get("targets", DEFAULT_CONFIG["targets"]))
    user = rng.choice(["root", "admin", "guest", "neo", ui.cfg.get("username", "operator")])
    ui.type_line(ui.prompt(), f"hydra -l {user} -P wordlist.txt ssh://{target}")
    for _ in range(rng.randint(8, 16)):
        if STOP: return
        pw = rng.choice(ui.cfg.get("wordlist", DEFAULT_CONFIG["wordlist"])) + str(rng.randint(0, 999))
        ui.line(f"[ATTEMPT] {user}:{pw:<24} -> ACCESS DENIED", "dim")
        ui.sleep(0.04)
    win = rng.choice(ui.cfg.get("wordlist", DEFAULT_CONFIG["wordlist"])) + "!"
    granted = "ACCESS GRANTED" + (" (fake)" if ui.show_disclaimer else "")
    ui.line(f"[ATTEMPT] {user}:{win:<24} -> {granted}", "bright")
    if ui.show_disclaimer:
        ui.line("Password cracked in 0.00s because this is a movie.", "dim")
    else:
        ui.line("Password hash matched. Session token issued.", "dim")
    ui.line()


def module_decrypt(ui: UI, rng: random.Random):
    fname = rng.choice(ui.cfg.get("download_files", DEFAULT_CONFIG["download_files"])) + ".enc"
    ui.type_line(ui.prompt(), f"decrypt --input {fname} --mode turbo-larp")
    ui.progress(f"decrypting {fname}", total=28, delay=0.035)
    for _ in range(6):
        if STOP: return
        ui.line(f"block {rand_hex(4)}:{rand_hex(4)}  key={rand_hex(16)}  status=OK", "dim")
        ui.sleep(0.05)
    msg = "Decryption complete. Contents: [REDACTED]" + (" (and also nonsense)." if ui.show_disclaimer else ".")
    ui.line(msg, "bright")
    ui.line()


def module_download(ui: UI, rng: random.Random):
    fname = rng.choice(ui.cfg.get("download_files", DEFAULT_CONFIG["download_files"]))
    host = rng.choice(ui.cfg.get("targets", DEFAULT_CONFIG["targets"]))
    size = rng.randint(10, 999)
    ui.type_line(ui.prompt(), f"curl -O https://{host}/loot/{fname}")
    ui.progress(f"downloading {fname} ({size}MB)", total=34, delay=0.03)
    suffix = " (not really)" if ui.show_disclaimer else ""
    ui.line(f"saved {fname} -> /tmp/{fname}{suffix}", "bright")
    ui.line()


def module_exploit(ui: UI, rng: random.Random):
    cve = f"CVE-{rng.randint(1999, 2026)}-{rng.randint(1000, 99999)}"
    target = rng.choice(ui.cfg.get("targets", DEFAULT_CONFIG["targets"]))
    ui.type_line(ui.prompt(), f"./exploit --target {target} --cve {cve} --safe")
    steps = [
        "fingerprinting target...", "checking vulnerable version...", "crafting payload...",
        "bypassing firewall with dramatic typing...", "spraying heap with glitter...",
        "getting shell... " + ("just kidding, simulation shell" if ui.show_disclaimer else "interactive session opened"), "cleaning traces" + (" (there are none)" if ui.show_disclaimer else "..."),
    ]
    for s in steps:
        if STOP: return
        ui.line(f"[*] {s}", "main")
        ui.sleep(0.12)
    if ui.show_disclaimer:
        ui.line(f"[+] {target} is now 73% more hacked-looking. ({cve})", "bright")
    else:
        ui.line(f"[+] Session established on {target}. ({cve})", "bright")
    ui.line()


def module_exfil(ui: UI, rng: random.Random):
    ui.type_line(ui.prompt(), "exfil --method dns --throttle cinematic")
    chunks = rng.randint(5, 12)
    for i in range(chunks):
        if STOP: return
        ui.line(f"chunk {i+1}/{chunks}  {rand_hex(24)}.{rand_hex(8)}.exfil.fake  sent", "dim")
        ui.sleep(0.07)
    msg = "Exfiltration complete." + (" Sent 0 bytes to real hosts." if ui.show_disclaimer else f" {chunks} chunks transferred.")
    ui.line(msg, "bright")
    ui.line()


def module_matrix(ui: UI, rng: random.Random):
    lines = int(ui.cfg.get("matrix_lines", 18))
    chars = "0123456789abcdef$%#@*+-=<>"
    width = min(ui.width, 100)
    ui.line("Entering matrix mode (briefly)...", "dim")
    for _ in range(lines):
        if STOP: return
        s = "".join(rng.choice(chars) for _ in range(width - 1))
        ui.line(s, "bright")
        ui.sleep(0.03)
    ui.line()



def module_wifi(ui: UI, rng: random.Random):
    ssids = ["CorpWiFi", "Free_Public_WiFi", "FBI_Van_7", "Printer_5G", "Mainframe_AP"]
    ssid = rng.choice(ssids)
    bssid = ":".join(rand_hex(2) for _ in range(6))
    ui.type_line(ui.prompt(), f"airodump-ng --bssid {bssid} --channel {rng.randint(1,11)} wlan0mon")
    ui.line(f"[+] Target: {ssid} ({bssid}) CH:{rng.randint(1,11)} ENC:WPA2", "bright")
    for _ in range(rng.randint(5, 10)):
        if STOP: return
        ui.line(f"[handshake] station={':'.join(rand_hex(2) for _ in range(6))} signal=-{rng.randint(30,80)}dBm", "dim")
        ui.sleep(0.08)
    ui.progress("capturing handshake", total=24, delay=0.04)
    ui.line("[+] WPA handshake captured. Cracking with wordlist...", "bright")
    ui.line()


def module_trace(ui: UI, rng: random.Random):
    target = rng.choice(ui.cfg.get("targets", DEFAULT_CONFIG["targets"]))
    ui.type_line(ui.prompt(), f"traceroute --cloak {target}")
    hops = rng.randint(6, 12)
    for i in range(1, hops + 1):
        if STOP: return
        ip = rand_ip(rng)
        ms = [round(rng.uniform(1, 80) + i*3, 2) for _ in range(3)]
        loc = rng.choice(["Frankfurt, DE", "Amsterdam, NL", "Reykjavik, IS", "Unknown", "Orbit, SPACE", "Cabinet, HOME"])
        ui.line(f"{i:2d}  {ip:<15}  {ms[0]:>6} ms  {ms[1]:>6} ms  {ms[2]:>6} ms  {loc}", "main")
        ui.sleep(0.09)
    ui.line(f"Trace complete: {hops} hops, route obfuscated.", "bright")
    ui.line()


def module_sqlinject(ui: UI, rng: random.Random):
    target = rng.choice(ui.cfg.get("targets", DEFAULT_CONFIG["targets"]))
    ui.type_line(ui.prompt(), f"sqlmap -u https://{target}/login?id=1 --batch --dbs")
    ui.line("[*] testing connection to the target URL", "dim")
    payloads = ["' OR 1=1--", "' UNION SELECT NULL--", "admin'--", "1; DROP TABLE users; --"]
    for pld in payloads:
        if STOP: return
        ui.line(f"[PAYLOAD] {pld}", "dim")
        ui.sleep(0.1)
        ui.line(f"[INFO] parameter 'id' appears {'injectable' if rng.random()>0.3 else 'clean'}", "main")
    ui.progress("dumping database schema", total=20, delay=0.05)
    for db in ["users", "secrets", "payments", "memes"]:
        ui.line(f"[DB] found table: {db} ({rng.randint(10,9999)} rows)", "bright")
        ui.sleep(0.05)
    ui.line()


