{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "right": 2 } },
  "display": { "separator": " " },
  "modules": [
    { "type": "os", "key": "os " },
    { "type": "kernel", "key": "kr " },
    { "type": "uptime", "key": "up " },
    { "type": "memory", "key": "mm " }
  ]
}
