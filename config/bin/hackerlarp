    ui.line()


def module_compile(ui: UI, rng: random.Random):
    proj = rng.choice(["backdoor", "kernel-module", "exploit-kit", "hacktool", "totally-benign-app"])
    ui.type_line(ui.prompt(), f"make -j{rng.randint(2,16)} {proj}")
    files = ["main.c", "payload.c", "crypto.c", "net.c", "ui.c", "obfuscate.c"]
    for f in rng.sample(files, k=rng.randint(4, 6)):
        if STOP: return
        warns = rng.randint(0, 3)
        ui.line(f"[CC] {f:<18}  OK  ({warns} warnings)", "main")
        ui.sleep(0.08)
    ui.line(f"[LD] linking {proj}...", "dim")
    ui.sleep(0.15)
    ui.line(f"[+] Built ./{proj} successfully. Don't actually run it." if ui.show_disclaimer else f"[+] Built ./{proj} successfully.", "bright")
    ui.line()


