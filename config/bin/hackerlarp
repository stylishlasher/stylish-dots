    "exploit": module_exploit,
    "exfil": module_exfil,
    "matrix": module_matrix,
    "wifi": module_wifi,
    "trace": module_trace,
    "sqlinject": module_sqlinject,
    "ddos": module_ddos,
    "bitcoin": module_bitcoin,
    "camera": module_camera,
    "git": module_git,
    "docker": module_docker,
    "phishing": module_phishing,
    "wipe": module_wipe,
    "compile": module_compile,
    "satellite": module_satellite,
    "firewall": module_firewall,
    "ssh_tunnel": module_ssh_tunnel,
}


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="hackerlarp",
        description="Configurable rofl/LARP Hollywood hacker terminal simulator (fake, harmless).",
    )
    p.add_argument("--config", help="Path to config JSON", default=None)
    p.add_argument("--write-config", action="store_true", help="Write default config to ~/.config/hackerlarp/config.json")
    p.add_argument("--list-modules", action="store_true", help="List available modules")
    p.add_argument("--modules", help="Comma-separated modules to run", default=None)
    p.add_argument("--speed", type=float, help="Speed multiplier (>1 faster)", default=None)
    p.add_argument("--duration", type=float, help="Seconds to run (0 = infinite)", default=None)
    p.add_argument("--theme", choices=list(THEMES.keys()), help="Color theme", default=None)
    p.add_argument("--no-color", action="store_true", help="Disable ANSI colors")
    p.add_argument("--seed", type=int, help="Random seed", default=None)
    p.add_argument("--once", action="store_true", help="Run selected modules once (no loop)")
    p.add_argument("--loop", action="store_true", help="Loop modules until Ctrl+C/duration")
    p.add_argument("--no-disclaimer", action="store_true", help="Hide simulation/fake disclaimer messages")
    p.add_argument("--disclaimer", action="store_true", help="Show simulation/fake disclaimer messages")
    return p.parse_args()


def main() -> int:
    global STOP
    args = parse_args()
    if args.list_modules:
        for k in MODULES:
            print(k)
        return 0

    cfg_path = Path(args.config).expanduser() if args.config else CONFIG_FILE
    if args.write_config:
        p = save_default_config(cfg_path)
        print(p)
        return 0

    cfg = load_config(cfg_path)
    if args.modules:
        cfg["modules"] = [m.strip() for m in args.modules.split(",") if m.strip()]
    if args.speed is not None:
        cfg["speed"] = args.speed
    if args.duration is not None:
        cfg["duration"] = args.duration
    if args.theme is not None:
        cfg["theme"] = args.theme
    if args.no_color:
        cfg["color"] = False
    if args.seed is not None:
        cfg["seed"] = args.seed
    if args.once:
        cfg["loop"] = False
    if args.loop:
        cfg["loop"] = True
    if args.no_disclaimer:
        cfg["show_disclaimer"] = False
    if args.disclaimer:
        cfg["show_disclaimer"] = True

    rng = random.Random(cfg.get("seed"))
    ui = UI(cfg)

    modules = [m for m in cfg.get("modules", []) if m in MODULES]
    if not modules:
        modules = ["banner", "scan", "matrix"]

    start = time.time()
    duration = float(cfg.get("duration", 0) or 0)
    STOP = False

    try:
        while not STOP:
            for name in modules:
                if STOP:
                    break
                if duration and (time.time() - start) >= duration:
                    STOP = True
                    break
                MODULES[name](ui, rng)
                ui.sleep(0.15)
            if not cfg.get("loop", True):
                break
    except KeyboardInterrupt:
        pass

    if ui.color:
        sys.stdout.write(RESET)
    if ui.show_disclaimer:
        print("\n[hackerlarp] Simulation ended. No systems were harmed.")
    else:
        print("\n[hackerlarp] Session ended.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
